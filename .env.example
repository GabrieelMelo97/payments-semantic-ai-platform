# ==============================================================================
# Payments Semantic AI Platform — Environment Configuration Example
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# Execution mode: "local" (DuckDB, $0 cost) or "gcp" (BigQuery + GCS + Vertex AI)
APP_ENV=local
LOG_LEVEL=INFO

# Local-First Storage (DuckDB)
LOCAL_DATA_DIR=data
DUCKDB_PATH=data/payments_warehouse.duckdb

# GCP Configuration (required only when APP_ENV=gcp)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_RAW_BUCKET=your-gcp-project-id-payments-raw-dev
BQ_DATASET_RAW=payments_raw
BQ_DATASET_MARTS=payments_marts
BQ_MAX_BYTES_BILLED=104857600

# AI Copilot Configuration (Gemini via Vertex AI or Google AI Studio)
# Options: "deterministic" (offline CI/dev, $0), "vertex_ai" (GCP ADC), "gemini_api"
AI_PROVIDER=deterministic
GEMINI_MODEL=gemini-2.5-flash
# Only needed if AI_PROVIDER=gemini_api (prefer vertex_ai with ADC in GCP)
GEMINI_API_KEY=
